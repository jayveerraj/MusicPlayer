<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/size_home_card"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_item_ripple"
    android:orientation="vertical"
    android:padding="@dimen/spacing_tiny">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <org.oxycblt.auxio.image.CoverView
            android:id="@+id/card_cover"
            android:layout_width="@dimen/size_home_card_cover"
            android:layout_height="@dimen/size_home_card_cover"
            app:enablePlaybackIndicator="false"
            app:enableSelectionBadge="false"
            app:iconSize="@dimen/size_icon_huge"
            app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Large" />

        <org.oxycblt.auxio.ui.RippleFixMaterialButton
            android:id="@+id/card_play"
            style="@style/Widget.Auxio.Button.Icon.Small.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/spacing_tiny"
            android:contentDescription="@string/lbl_play"
            app:icon="@drawable/ic_play_24" />

    </FrameLayout>

    <TextView
        android:id="@+id/card_name"
        style="@style/Widget.Auxio.TextView.Item.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:layout_marginTop="@dimen/spacing_small"
        tools:text="Roadtrip" />

    <TextView
        android:id="@+id/card_info"
        style="@style/Widget.Auxio.TextView.Item.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        tools:text="Folder • 24 songs" />

</LinearLayout>
